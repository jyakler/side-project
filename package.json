    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
